# ConfliBERT-v2 path contract for NCSA Delta.
# Copy to hpc/paths.env, fill in your allocation, and never commit the copy
# (it is gitignored). Every sbatch script sources hpc/paths.env.
#
# Layout philosophy (see docs/HPC_DELTA.md):
#   - code       -> /projects (persistent, backed up, small)
#   - venv       -> /projects (persistent; rebuilding is slow)
#   - corpus,    -> /scratch  (large, fast, PURGED after ~30 days idle --
#     packs,                   everything here must be regenerable or synced out)
#     checkpoints

# --- identity: your allocation short code, e.g. "bcaq" ---
export CB2_ALLOC="CHANGE_ME"

# Slurm accounts derived from the allocation (Delta convention)
export CB2_ACCOUNT_GPU="${CB2_ALLOC}-delta-gpu"
export CB2_ACCOUNT_CPU="${CB2_ALLOC}-delta-cpu"

# --- locations ---
export CB2_ROOT="/projects/${CB2_ALLOC}/${USER}/conflibert-v2"   # this repo, cloned
export CB2_VENV="/projects/${CB2_ALLOC}/${USER}/cb2-venv"        # python env
export CB2_SCRATCH="/scratch/${CB2_ALLOC}/${USER}/cb2"           # big fast data

export CB2_CORPUS="${CB2_SCRATCH}/corpus/parquet"   # Stage-1 output (Parquet shards)
export CB2_PACKED="${CB2_SCRATCH}/packed"           # Stage-2 output (token memmaps)
export CB2_OUT="${CB2_SCRATCH}/runs"                # Stage-3 output (checkpoints)
export CB2_MODELS="${CB2_SCRATCH}/models"           # finalized models (also sync to /projects!)

# HuggingFace cache on scratch, NOT $HOME (home quota is small)
export HF_HOME="${CB2_SCRATCH}/hf_cache"

# --- run defaults (override per sbatch submission if needed) ---
export CB2_SEQLEN=1024
export CB2_TOKENIZER="answerdotai/ModernBERT-base"
export CB2_SOURCE_WEIGHTS="News=1.0,Organization=1.0,UTDstory=1.0,Gigaword=0.7,Wikipedia=0.25"
